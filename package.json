{
  "name": "izan",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension MCP server - give any AI the power to use a browser",
  "keywords": ["mcp", "chrome-extension", "browser-automation", "ai-tools", "claude-desktop"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ekingunoncu/izan.io.git"
  },
  "homepage": "https://izan.io",
  "bugs": {
    "url": "https://github.com/ekingunoncu/izan.io/issues"
  },
  "author": "izan.io contributors",
  "license": "AGPL-3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "build:extension": "npm run build -w @izan/extension",
    "build:bridge": "npm run build -w izan-mcp"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "npm@10.0.0"
}
